      "id": "node-http-stock",
      "name": "Get Stock La Fria",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1010,
        700
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TrJohe1m6YnvSfc6",
          "name": "KBToodles - Stock API Key"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const branchNames = { \"la-fria\": \"La Fr\\u00eda\", \"colon\": \"Col\\u00f3n\" };\n\nfunction esc(v) {\n  return String(v).replace(/[_*\\[\\]()~`>#+=|{}.!-]/g, \"\\\\$&\");\n}\nfunction money(n) {\n  return esc(Number(n).toLocaleString(\"es-CO\", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));\n}\n\nconst MAX_PER_BRANCH = 5;\nconst results = $input.all().map((item) => item.json);\n\nconst lines = [];\nfor (const r of results) {\n  const name = branchNames[r.branch] || r.branch;\n  lines.push(`\\ud83c\\udfe2 *${esc(name)}*`);\n\n  if (!r.available) {\n    lines.push(\"  \\u26a0\\ufe0f No disponible en este momento\\\\.\");\n    lines.push(\"\");\n    continue;\n  }\n\n  const products = r.products || [];\n  if (!products.length) {\n    lines.push(\"  No se encontr\\u00f3 ning\\u00fan producto\\\\.\");\n  } else {\n    products.slice(0, MAX_PER_BRANCH).forEach((p) => {\n      lines.push(`  *${esc(p.codigo)}* \\\\- ${esc(p.nombre)}`);\n      lines.push(`    \\ud83d\\udcb0 $${money(p.precio)}   \\ud83d\\udce6 Stock: ${esc(p.stock)}`);\n    });\n    if (products.length > MAX_PER_BRANCH) {\n      lines.push(`  _...y ${esc(products.length - MAX_PER_BRANCH)} m\\u00e1s._`);\n    }\n  }\n  lines.push(\"\");\n}\n\nreturn [{ json: { text: lines.join(\"\\n\").trim() } }];"
      },
