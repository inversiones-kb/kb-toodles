      "parameters": {
        "jsCode": "// \"/consulta 010012\" or \"/consulta foami\" - everything after the\n// command is the search term. All ADN product codes seen so far are\n// pure digit strings, so that's the heuristic for code vs. name search.\nconst text = ($input.first().json.message && $input.first().json.message.text) || \"\";\nconst match = text.match(/^\\/consulta\\s+(.+)$/i);\nconst term = match ? match[1].trim() : \"\";\nconst isCode = /^\\d+$/.test(term);\nreturn [{ json: { term, isCode } }];"
      },
