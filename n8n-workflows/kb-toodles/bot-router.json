    {
      "parameters": {
        "jsCode": "// Optional trailing date: \"/cuadre\" or \"/cuadre 2026-09-25\".\n// Anything else after the command (typo, garbage) is ignored, falling\n// back to the API's own default (yesterday's business day).\nconst text = ($input.first().json.message && $input.first().json.message.text) || \"\";\nconst match = text.match(/^\\/cuadre(?:\\s+(\\d{4}-\\d{2}-\\d{2}))?/);\nconst dateParam = (match && match[1]) || null;\nreturn [{ json: { dateParam } }];"
      },
      "id": "node-parse-date",
      "name": "Parse Date Arg",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        570,
        60
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://kb-toodles.vercel.app/api/reports/daily-conciliation\" + ($json.dateParam ? (\"?date=\" + $json.dateParam) : \"\") }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "node-http-conciliacion",
      "name": "Get Daily Conciliation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        790,
        60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3NbEea5FB1IWmRGm",
          "name": "KBToodles - Reports API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst branchNames = { \"la-fria\": \"La Fría\", \"colon\": \"Colón\" };\n\n// MarkdownV2 requires escaping these outside intentional * bold * / _ italic _ spans.\nfunction esc(v) {\n  return String(v).replace(/[_*\\[\\]()~`>#+=|{}.!-]/g, \"\\\\$&\");\n}\n\n// COP has no cents in practice; force whole pesos so floating-point\n// remainders (e.g. from usd cash * rate) don't leak in as \",28\".\nfunction money(n) {\n  return esc(Number(n).toLocaleString(\"es-CO\", { maximumFractionDigits: 0 }));\n}\n\nconst lines = [`📊 *Cuadre de caja* \\\\- ${esc(data.date)}`, \"\"];\n\nfor (const key of Object.keys(data.branches || {})) {\n  const b = data.branches[key];\n  const name = branchNames[key] || key;\n  lines.push(`🏢 *${esc(name)}*`);\n  lines.push(`💰 Total recaudado: $${money(b.total_collected_cop)}`);\n  lines.push(`💸 Total gastos: $${money(b.total_expenses_cop)}`);\n  lines.push(`⚠️ Total diferencia: $${money(b.total_diff_cop)}`);\n  for (const d of b.discrepancies || []) {\n    lines.push(`  ↳ Caja ${esc(d.checkout_number)}: $${money(d.diff)}`);\n  }\n  lines.push(\"\");\n}\n\nreturn [{ json: { text: lines.join(\"\\n\").trim() } }];"
      },
