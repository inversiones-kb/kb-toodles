      "id": "node-router-switch",
      "name": "Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "// Optional trailing date: \"/cuadre\" or \"/cuadre 2026-09-25\".\n// Anything else after the command (typo, garbage) is ignored, falling\n// back to the API's own default (yesterday's business day).\nconst text = ($input.first().json.message && $input.first().json.message.text) || \"\";\nconst match = text.match(/^\\/cuadre(?:\\s+(\\d{4}-\\d{2}-\\d{2}))?/);\nconst dateParam = (match && match[1]) || null;\nreturn [{ json: { dateParam } }];"
      },
      "id": "node-parse-date",
      "name": "Parse Date Arg",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 60]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://kb-toodles.vercel.app/api/reports/daily-conciliation\" + ($json.dateParam ? (\"?date=\" + $json.dateParam) : \"\") }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "node-http-conciliacion",
      "name": "Get Daily Conciliation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 60],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3NbEea5FB1IWmRGm",
          "name": "KBToodles - Reports API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst branchNames = { \"la-fria\": \"La Fr\\u00eda\", \"colon\": \"Col\\u00f3n\" };\n\n// MarkdownV2 requires escaping these outside intentional * bold * / _ italic _ spans.\nfunction esc(v) {\n  return String(v).replace(/[_*\\[\\]()~`>#+=|{}.!-]/g, \"\\\\$&\");\n}\n\nconst lines = [`\\ud83d\\udcca *Cuadre de caja* \\\\- ${esc(data.date)}`, \"\"];\n\nfor (const key of Object.keys(data.branches || {})) {\n  const b = data.branches[key];\n  const name = branchNames[key] || key;\n  lines.push(`\\ud83c\\udfec *${esc(name)}*`);\n  lines.push(`\\u2705 Cuadradas: ${esc(b.matched)}`);\n  lines.push(`\\u23f3 Pendientes: ${esc(b.pending)}`);\n  lines.push(`\\u26a0\\ufe0f Con diferencia: ${esc(b.discrepancy)}`);\n  if (b.total_diff_cop !== 0) {\n    lines.push(`Diferencia total: $${esc(Number(b.total_diff_cop).toLocaleString(\"es-CO\"))}`);\n  }\n  lines.push(\"\");\n}\n\nreturn [{ json: { text: lines.join(\"\\n\").trim() } }];"
      },
      "id": "node-format-conciliacion",
      "name": "Format Conciliation Message",
