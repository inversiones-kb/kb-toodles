{
  "name": "[kb-toodles] Stock Server Healthcheck",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 10 }]
        }
      },
      "id": "node-schedule",
      "name": "Every 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://REPLACE_ME.your-tailnet.ts.net/health",
        "options": {
          "timeout": 5000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "node-http-health",
      "name": "Check La Fria",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-down",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-down",
      "name": "Is Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_ME_CHAT_ID",
        "text": "⚠️ Servidor de stock (La Fría) no responde\\. Revisar la máquina y la conexión Tailscale\\.",
        "additionalFields": { "appendAttribution": false, "parse_mode": "MarkdownV2" }
      },
      "id": "node-reply-alert",
      "name": "Alert Down",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 300],
      "credentials": {
        "telegramApi": {
          "id": "uzNbbuoJIIq0FtAO",
          "name": "KBToodles - Telegram"
        }
      }
    }
  ],
  "connections": {
    "Every 10 min": {
      "main": [[{ "node": "Check La Fria", "type": "main", "index": 0 }]]
    },
    "Check La Fria": {
      "main": [[{ "node": "Is Down?", "type": "main", "index": 0 }]]
    },
    "Is Down?": {
      "main": [[{ "node": "Alert Down", "type": "main", "index": 0 }], []]
    }
  }
}
